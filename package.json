{
  "name": "scissor-app",
  "version": "0.1.0",
  "description": "Local video dedupe and simple cut/insert export (macOS / Windows)",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "node scripts/ensure-win-binaries.cjs && npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.scissor.app",
    "productName": "Scissor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/pngjs/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/ffmpeg",
      "**/node_modules/ffmpeg-static/ffmpeg.exe",
      "**/node_modules/ffprobe-static/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/luts",
        "to": "luts"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "extraResources": [
        {
          "from": "resources/darwin",
          "to": "darwin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/win",
          "to": "win",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
